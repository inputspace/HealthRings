<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0F0F1A">

    <TextView
        android:text="💙"
        android:textSize="48sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:text="Why Health Rings needs access"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:text="Health Rings reads your steps, distance, calories and exercise sessions from Health Connect to display your activity rings. Your data never leaves your phone."
        android:textColor="#AAFFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnOk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Got it"
        android:backgroundTint="#1D9E75"
        android:textColor="#FFFFFF"/>

</LinearLayout>
